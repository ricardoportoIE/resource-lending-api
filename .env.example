# Copy this file to .env and replace every placeholder before starting the API.
DB_URL=jdbc:postgresql://localhost:5432/resource_lending
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional comma-separated browser origins, for example http://localhost:3000
CORS_ALLOWED_ORIGINS=
# Optional ISO-8601 reservation pickup window and expiry scan interval
RESERVATION_READY_WINDOW=P2D
RESERVATION_EXPIRY_SCAN_MS=60000
# Optional transactional outbox tuning and webhook target (blank uses the log delivery adapter)
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE=PT30S
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_DUE_SOON_WINDOW=PT24H
NOTIFICATION_DUE_SOON_SCAN_MS=60000
# Use ecs for structured JSON logs or leave this runtime-specific.
LOG_FORMAT=ecs
